+package org.omg.kerml.xtext.scoping;
+
+import org.eclipse.emf.ecore.EReference;
+import org.eclipse.xtext.scoping.IScope;
+import org.omg.sysml.lang.sysml.Element;
+import org.omg.sysml.lang.sysml.Namespace;
+
+/**
+ * A KerMLScopeProvider whose scopes are MemoKerMLScopes.
+ */
+public class MemoKerMLScopeProvider extends KerMLScopeProvider {
+
+	@Override
+	public IScope scopeFor(Namespace pack, EReference reference, Element element, boolean isInsideScope,
+			boolean isFirstScope, boolean isRedefinition, Element skip) {
+		return memoScopeFor(this, super.scopeFor(pack, reference, element, isInsideScope, isFirstScope, isRedefinition, skip),
+				pack, reference, element, isInsideScope, isFirstScope, isRedefinition, skip);
+	}
+
+	/**
+	 * Replaces the KerMLScope created by KerMLScopeProvider.scopeFor with an equivalent MemoKerMLScope.
+	 * (The outer scopes of the given scope have already been created by the overriding scopeFor.)
+	 */
+	public static IScope memoScopeFor(KerMLScopeProvider scopeProvider, IScope scope, Namespace pack, EReference reference,
+			Element element, boolean isInsideScope, boolean isFirstScope, boolean isRedefinition, Element skip) {
+		return new MemoKerMLScope(((KerMLScope)scope).getParent(), pack, reference.getEReferenceType(), scopeProvider,
+				isInsideScope, isFirstScope, isRedefinition, element, skip);
+	}
+
+}
